{
  "name": "spuddy",
  "productName": "Spuddy",
  "version": "0.1.0",
  "description": "A crocheted spuddy desktop pet that brings you encouragement",
  "license": "MIT",
  "main": "electron/main.cjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/akumatus/spuddy.git"
  },
  "scripts": {
    "postinstall": "node scripts/copy-assets.cjs",
    "icon": "node scripts/make-icon.cjs",
    "dev": "node scripts/set-dev-name.cjs && vite build && electron .",
    "start": "node scripts/set-dev-name.cjs && vite build && electron .",
    "build": "vite build",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "postversion": "git push --follow-tags"
  },
  "build": {
    "appId": "com.spuddy.app",
    "productName": "Spuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.lifestyle",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "akumatus",
        "repo": "spuddy"
      }
    ]
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "draco3dgltf": "^1.5.7",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.3",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
