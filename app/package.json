{
  "name": "spuddy",
  "productName": "Spuddy",
  "version": "0.1.0",
  "description": "A crocheted spuddy desktop pet that brings you encouragement",
  "license": "MIT",
  "main": "electron/main.cjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/akumatus/spuddy.git"
  },
  "scripts": {
    "postinstall": "node scripts/copy-assets.cjs",
    "icon": "node scripts/make-icon.cjs",
    "dev": "node scripts/set-dev-name.cjs && yarn build && electron .",
    "start": "node scripts/set-dev-name.cjs && yarn build && electron .",
    "build": "vite build && yarn build:electron",
    "build:electron": "esbuild electron/src/main.ts electron/src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=electron --out-extension:.js=.cjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json",
    "dist:mac": "yarn build && electron-builder --mac --publish never",
    "postversion": "git push --follow-tags"
  },
  "build": {
    "appId": "com.spuddy.app",
    "productName": "Spuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.lifestyle",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "Developer ID Application: YUE WU (76GBLFCPBF)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "akumatus",
        "repo": "spuddy"
      }
    ]
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/node": "^26.1.0",
    "@types/three": "~0.170.0",
    "draco3dgltf": "^1.5.7",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "packageManager": "yarn@4.9.1+sha256.6ffc213b3ce0af5c92507977d9537ea3cc085caa52d1c3f08e94d613407fed19"
}
