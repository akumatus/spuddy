{
  "name": "spuddy-server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "gen:dev": "curl -s -X POST 'http://localhost:8787/admin/generate?lang=en' -H \"x-pp-admin: dev\" && curl -s -X POST 'http://localhost:8787/admin/generate?lang=zh' -H \"x-pp-admin: dev\"",
    "typecheck": "tsc",
    "eval:build": "esbuild eval/memory-eval.ts --bundle --platform=node --format=esm --outfile=eval/run.mjs --log-level=warning",
    "eval": "npm run eval:build && node eval/run.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^6.0.3",
    "wrangler": "^3.90.0"
  }
}
